{"cats":{"heritage":["Temples & heritage","கோயில்களும் மரபும்"],"rivers":["Cauvery & waterworks","காவிரியும் நீர்ப்பணிகளும்"],"landmarks":["Landmarks","அடையாளங்கள்"],"areas":["Neighbourhoods","பகுதிகள்"]},"places":[{"name":"Rockfort","ta":"மலைக்கோட்டை","area":"Rockfort","cat":"heritage","blurb":"A rock about 83 metres high rises from the middle of the old city. A steep stair climbs to the Ucchi Pillayar temple on top, and Pallava-era cave temples sit at its foot. The Madurai Nayaks fortified it, and it was fought over in the Carnatic Wars.","x":52542,"y":29214,"lat":10.8283,"lon":78.6972,"slug":"rockfort","n":1,"img":"assets/places/rockfort.webp","checked":false},{"name":"Sri Ranganathaswamy Temple","ta":"ஸ்ரீரங்கநாதசுவாமி கோயில்","area":"Srirangam","cat":"heritage","blurb":"One of the largest functioning Hindu temples in the world, enclosed by seven concentric walls across roughly 156 acres. The Raja Gopuram at the south gate, completed in 1987, rises about 73 metres.","x":43404,"y":26242,"lat":10.8624,"lon":78.6899,"slug":"srirangam-temple","n":2,"img":"assets/places/srirangam-temple.webp","checked":false},{"name":"Jambukeswarar Temple","ta":"ஜம்புகேஸ்வரர் கோயில்","area":"Thiruvanaikaval","cat":"heritage","blurb":"The Shiva shrine of the element water, where the sanctum floor is kept damp by a spring. It lies on Srirangam island about a kilometre from the Ranganathaswamy temple.","x":48850,"y":25531,"lat":10.8533,"lon":78.7056,"slug":"jambukeswarar","n":3,"img":"assets/places/jambukeswarar.webp","checked":false},{"name":"Teppakulam","ta":"தெப்பக்குளம்","area":"Rockfort","cat":"heritage","blurb":"The big temple tank at the foot of the Rock, with a small mandapam in the middle. The bazaar streets around it are among the busiest in the city.","x":51933,"y":29784,"lat":10.8271,"lon":78.6932,"slug":"teppakulam","n":4,"img":"assets/places/teppakulam.webp","checked":false},{"name":"Samayapuram Mariamman Temple","ta":"சமயபுரம் மாரியம்மன் கோயில்","area":"Samayapuram","cat":"heritage","blurb":"A Mariamman shrine on the Chennai highway north of the city, and one of the busiest pilgrimage temples in Tamil Nadu.","x":41779,"y":14670,"lat":10.9184,"lon":78.7391,"slug":"samayapuram","n":5,"img":"assets/places/samayapuram.webp","checked":false},{"name":"Vayalur Murugan Temple","ta":"வயலூர் முருகன் கோயில்","area":"Vayalur","cat":"heritage","blurb":"A Murugan temple west of the city, praised in the Thiruppugazh hymns of Arunagirinathar. A tall gopuram marks the entrance to its walled courtyard.","x":36206,"y":37249,"lat":10.8289,"lon":78.6231,"slug":"vayalur","n":6,"img":"assets/places/vayalur.webp","checked":false},{"name":"Woraiyur Vekkaliamman Temple","ta":"உறையூர் வெக்காளியம்மன் கோயில்","area":"Woraiyur","cat":"heritage","blurb":"Woraiyur is the old Uraiyur, an early Chola capital named in Sangam poetry. The Vekkaliamman temple is its best known shrine.","x":46350,"y":31956,"lat":10.8299,"lon":78.6705,"slug":"woraiyur","n":7,"img":"assets/places/woraiyur.webp","checked":false},{"name":"Our Lady of Lourdes Church","ta":"லூர்து அன்னை ஆலயம்","area":"Rockfort","cat":"heritage","blurb":"A Catholic church beside St. Joseph's College, said to be modelled on the basilica at Lourdes in France. Its spire is a landmark in the old city.","x":51867,"y":29839,"lat":10.827,"lon":78.6928,"slug":"lourdes-church","n":8,"img":"assets/places/lourdes-church.webp","checked":false},{"name":"Erumbeeswarar Temple","ta":"எறும்பீசுவரர் கோயில்","area":"Thiruverumbur","cat":"heritage","blurb":"A Shiva temple on a low rocky hill in Thiruverumbur, in the industrial east of the city.","x":75766,"y":25475,"lat":10.7927,"lon":78.7674,"slug":"erumbeeswarar","n":9,"img":"assets/places/erumbeeswarar.webp","checked":false},{"name":"Amma Mandapam Ghat","ta":"அம்மா மண்டபம்","area":"Srirangam","cat":"heritage","blurb":"The bathing ghat on the Cauvery at Srirangam. Pilgrims bathe here, and crowds gather during the Aadi Perukku river festival.","x":46832,"y":27955,"lat":10.8469,"lon":78.6899,"slug":"amma-mandapam","n":10,"img":"assets/places/amma-mandapam.webp","checked":false},{"name":"Kallanai (Grand Anicut)","ta":"கல்லணை","area":"Kallanai","cat":"rivers","blurb":"Built by the Chola king Karikalan around the 2nd century CE, it is among the oldest water-regulation structures still in use. It sends Cauvery water into the delta. The British engineer Arthur Cotton restored it in the 19th century.","x":78447,"y":15554,"lat":10.8315,"lon":78.8189,"slug":"kallanai","n":11,"img":"assets/places/kallanai.webp","checked":false},{"name":"Mukkombu (Upper Anicut)","ta":"முக்கொம்பு","area":"Mukkombu","cat":"rivers","blurb":"Where the Cauvery divides, sending the Kollidam off to the north. The Upper Anicut regulator controls the flow, and the riverside park is a popular day out.","x":13754,"y":35339,"lat":10.8883,"lon":78.5805,"slug":"mukkombu","n":12,"img":"assets/places/mukkombu.webp","checked":false},{"name":"Kaveri Bridge","ta":"காவிரி பாலம்","area":"Cauvery","cat":"rivers","blurb":"The long bridge that joins the city to Srirangam island across the Cauvery.","x":50109,"y":27976,"lat":10.8394,"lon":78.6973,"slug":"kaveri-bridge","n":13,"img":"assets/places/kaveri-bridge.webp","checked":false},{"name":"New Kollidam Bridge","ta":"புதிய கொள்ளிடம் பாலம்","area":"Kollidam","cat":"rivers","blurb":"Carries the road across the broad, sandy bed of the Kollidam on the north side of Srirangam island.","x":45846,"y":24313,"lat":10.8656,"lon":78.7043,"slug":"kollidam-bridge","n":14,"img":"assets/places/kollidam-bridge.webp","checked":false},{"name":"Tiruchirappalli Junction","ta":"திருச்சி சந்திப்பு","area":"Junction","cat":"landmarks","blurb":"Southern Railway's busy junction and the seat of the Tiruchirappalli division, with lines to Chennai, Madurai, Thanjavur and Karur.","x":57525,"y":34286,"lat":10.7941,"lon":78.6854,"slug":"trichy-junction","n":15,"img":"assets/places/trichy-junction.webp","checked":false},{"name":"Central Bus Stand","ta":"மத்திய பேருந்து நிலையம்","area":"Junction","cat":"landmarks","blurb":"The main bus terminus, close to the railway junction, with services across Tamil Nadu.","x":55524,"y":34291,"lat":10.7986,"lon":78.6808,"slug":"central-bus-stand","n":16,"img":"assets/places/central-bus-stand.webp","checked":false},{"name":"Chatram Bus Stand","ta":"சத்திரம் பேருந்து நிலையம்","area":"Rockfort","cat":"landmarks","blurb":"The bus stand near Rockfort. Its name recalls the old pilgrim rest-houses, called chatrams.","x":51007,"y":29232,"lat":10.83169,"lon":78.69361,"slug":"chatram","n":17,"img":"assets/places/chatram.webp","checked":false},{"name":"Anna Stadium","ta":"அண்ணா விளையாட்டரங்கம்","area":"Anna Nagar","cat":"landmarks","blurb":"The city's main sports ground, with a football pitch, a running track and tiered stands that host district meets and local matches.","x":62966,"y":34564,"lat":10.78054,"lon":78.69657,"slug":"anna-stadium","n":18,"img":"assets/places/anna-stadium.webp","checked":false},{"name":"Gandhi Market","ta":"காந்தி சந்தை","area":"Gandhi Market","cat":"landmarks","blurb":"The city's wholesale market for vegetables, fruit and flowers, busy from before dawn.","x":55475,"y":30523,"lat":10.81575,"lon":78.69792,"slug":"gandhi-market","n":19,"img":"assets/places/gandhi-market.webp","checked":false},{"name":"St. Joseph's College","ta":"புனித வளனார் கல்லூரி","area":"Rockfort","cat":"landmarks","blurb":"A Jesuit college founded in 1844 that has been in Tiruchirappalli since 1883, with a long campus below the Rock.","x":51712,"y":29739,"lat":10.8278,"lon":78.6929,"slug":"st-josephs","n":20,"img":"assets/places/st-josephs.webp","checked":false},{"name":"Golden Rock Railway Workshop","ta":"பொன்மலை ரயில்வே பணிமனை","area":"Ponmalai","cat":"landmarks","blurb":"A large Southern Railway workshop. The neighbourhood is called Ponmalai, 'golden hill', after a small rocky hill nearby.","x":66523,"y":30738,"lat":10.7898,"lon":78.7222,"slug":"golden-rock","n":21,"img":"assets/places/golden-rock.webp","checked":false},{"name":"Tiruchirappalli International Airport","ta":"திருச்சி பன்னாட்டு விமான நிலையம்","area":"Airport","cat":"landmarks","blurb":"The city's airport, known for direct flights to Singapore, Malaysia, the Gulf and Sri Lanka.","x":70992,"y":35093,"lat":10.76,"lon":78.7125,"slug":"airport","n":22,"img":"assets/places/airport.webp","checked":false},{"name":"NIT Tiruchirappalli","ta":"தேசிய தொழில்நுட்பக் கழகம்","area":"NIT","cat":"landmarks","blurb":"Founded in 1964 as the Regional Engineering College and now one of India's National Institutes of Technology.","x":93890,"y":23910,"lat":10.7588,"lon":78.816,"slug":"nit","n":23,"img":"assets/places/nit.webp","checked":false},{"name":"BHEL Township","ta":"பெல் நகரியம்","area":"Thiruverumbur","cat":"landmarks","blurb":"BHEL's boiler plant, set up in the 1960s, anchors the township and the industrial belt of Thiruverumbur.","x":85355,"y":23688,"lat":10.7791,"lon":78.7975,"slug":"bhel","n":24,"img":"assets/places/bhel.webp","checked":false},{"name":"Panjappur Integrated Bus Terminus","ta":"பஞ்சப்பூர் ஒருங்கிணைந்த பேருந்து முனையம்","area":"Panjappur","cat":"landmarks","blurb":"The city's new integrated bus terminus at Panjappur on the Madurai highway, with long canopied bus bays, a terminal hall and large car parks.","x":59845,"y":41910,"lat":10.75438,"lon":78.65584,"slug":"panjappur-terminus","n":25,"img":"assets/places/panjappur-terminus.webp","checked":false},{"name":"Tropical Butterfly Conservatory","ta":"பட்டாம்பூச்சி பூங்கா","area":"Melur, Srirangam","cat":"landmarks","blurb":"A large butterfly park at Melur on the western end of Srirangam island, with landscaped gardens, lily ponds and glass conservatory domes.","x":28257,"y":30443,"lat":10.87765,"lon":78.63605,"slug":"butterfly-park","n":26,"img":"assets/places/butterfly-park.webp","checked":false},{"name":"Anna Science Centre Planetarium","ta":"அண்ணா அறிவியல் மையக் கோளரங்கம்","area":"Pudukkottai Road","cat":"landmarks","blurb":"A science centre and planetarium on the Pudukkottai road near the airport, with a domed sky theatre and science galleries.","x":67261,"y":35148,"lat":10.76819,"lon":78.70372,"slug":"planetarium","n":27,"img":"assets/places/planetarium.webp","checked":false},{"name":"Srirangam","ta":"ஸ்ரீரங்கம்","area":"Srirangam","cat":"areas","blurb":"The island between the Cauvery and the Kollidam. Its streets run in concentric squares around the great temple.","x":46151,"y":26062,"lat":10.857,"lon":78.697,"slug":"srirangam","n":28,"img":"assets/places/srirangam.webp","checked":false},{"name":"Thillai Nagar","ta":"தில்லை நகர்","area":"Thillai Nagar","cat":"areas","blurb":"A leafy residential and shopping neighbourhood west of the Rock, known for its cafes and showrooms.","x":50851,"y":31342,"lat":10.8225,"lon":78.6836,"slug":"thillai-nagar","n":29,"img":"assets/places/thillai-nagar.webp","checked":false},{"name":"Woraiyur","ta":"உறையூர்","area":"Woraiyur","cat":"areas","blurb":"A close-grained old quarter west of the city centre, once a Chola capital.","x":49054,"y":31931,"lat":10.8239,"lon":78.6768,"slug":"woraiyur-area","n":30,"img":"assets/places/woraiyur-area.webp","checked":false},{"name":"Thiruverumbur","ta":"திருவெறும்பூர்","area":"Thiruverumbur","cat":"areas","blurb":"A town in the east of the city that grew around its hill temple and the BHEL works.","x":74187,"y":25932,"lat":10.7942,"lon":78.7617,"slug":"thiruverumbur","n":31,"img":"assets/places/thiruverumbur.webp","checked":false},{"name":"Ponmalai","ta":"பொன்மலை","area":"Ponmalai","cat":"areas","blurb":"The railway workshop quarter around the Golden Rock hill, south-east of the junction.","x":67692,"y":31082,"lat":10.7856,"lon":78.7233,"slug":"ponmalai","n":32,"img":"assets/places/ponmalai.webp","checked":false},{"name":"Beema Nagar","ta":"பீமா நகர்","area":"Beema Nagar","cat":"areas","blurb":"A busy neighbourhood between the Junction and the old city, next to Palakkarai.","x":55739,"y":31950,"lat":10.8087,"lon":78.692,"slug":"beema-nagar","n":33,